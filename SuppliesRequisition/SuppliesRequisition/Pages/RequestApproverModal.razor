@code {
    private string? positions, Scompany, SuserId, Semail, Sid;

    private string selectedItemCode { get; set; } = ""; // Property for two-way binding
    private Items selectedItem { get; set; } = new Items();
    private string selectedItemDescription { get; set; } = "";

    [Parameter] public string RequestDetails { get; set; } // Ensure this is public
    [Parameter] public RequisitionHeader RequestItemDetails { get; set; } // Ensure this is public
    [Parameter] public RequisitionHeader Request { get; set; }


    private int headerId;
    private List<Approvers>? approvers;
    private List<AppUser>? users;
    private string? userEmail { get; set; }
    private string? tempItemCode { get; set; }
    private string tempItemDescription { get; set; }
    private int tempQuantity { get; set; }
    private string tempUOM { get; set; }
    private string tempRemarks {get; set;}
    private bool showConfirmModal = false;
    private RequisitionHeader requestDetails;
    private ConfirmApprovedModal selectedApprovedRequest;
    private ConfirmDeniedModal selectedDeniedRequest;


    private List<RequisitionDetail> CombinedDetails => 
        RequestItemDetails.details
            .Where(x => !ExcludedItemCodes.Contains(x.ItemCode))
            .Concat(rows.Select(r => new RequisitionDetail
            {
                ItemCode = r.ItemCode ?? string.Empty,
                ItemDescription = r.ItemDescription ?? string.Empty,
                Quantity = r.Quantity,
                UOM = r.StockUom ?? string.Empty,
                Notes = r.Remarks ?? string.Empty,
                Remarks = r.Remarks ?? string.Empty,
                Consumption = r.Consumption ?? string.Empty,
                SapStatus = string.Empty,
                HeaderId = RequestItemDetails.HeaderId, // Use current HeaderId
                DetailId = 0
            }))
            .ToList();


    private List<Items>? Items;
    private List<TableRow> rows { get; set; } = new List<TableRow>();

    private List<string> ExcludedItemCodes { get; set; } = new List<string>();

    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public EventCallback<bool> OnCancel { get; set; }


    private string ModalStyle => ShowModal ? "display: block;" : "display: none;";
    private bool ShowModal { get; set; }


    private string GetStatusClass(string status)
    {
        // Define the sequence of statuses
        var statusSequence = new List<string> { "For Review", "For Approval", "Picking", "Packing", "Completed" };

        // If the request is Denied or Canceled, all tabs are unprogressed
        if (RequestItemDetails.Status == "Denied" || RequestItemDetails.Status == "Canceled")
        {
            return "unprogress-status";
        }

        // Find the index of the current status and the target status
        int currentStatusIndex = statusSequence.IndexOf(RequestItemDetails.Status);
        int targetStatusIndex = statusSequence.IndexOf(status);

        // If the target status is before or equal to the current status, it's completed or in progress
        if (targetStatusIndex < currentStatusIndex)
        {
            return "progress-status";
        }
        else if (targetStatusIndex == currentStatusIndex)
        {
            return "onprogress-status";
        }
        else
        {
            return "unprogress-status";
        }
    }


    private void ShowConfirmModal()
    {
        showConfirmModal = true;
        StateHasChanged();
    }

    private void CancelModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task ConfirmSave()
    {
        showConfirmModal = false;
        await SaveChanges();
        StateHasChanged();
    }


    public void OpenModal()
    {
        ShowModal = true;
        StateHasChanged(); // Update the UI
    }

    public void CloseModal()
    {
        //OnCancel.InvokeAsync(false);
        CloseModal();
    }

    private void Confirm()
    {
        OnConfirm.InvokeAsync(true);
        CloseModal();
    }
    private void Close()
    {
        ShowModal = false;
        StateHasChanged(); // Update the UI
    }


    private async Task SaveChanges()
    {
        // 1. Delete excluded items from requisitiondetails
        if (ExcludedItemCodes.Any())
        {
            string deleteSql = @"DELETE FROM requisitiondetails WHERE HeaderId = @HeaderId AND ItemCode IN @ItemCodes";
            var parameters = new
            {
                HeaderId = RequestItemDetails.HeaderId,
                ItemCodes = ExcludedItemCodes
            };
            await _data.SaveData(deleteSql, parameters, _config.GetConnectionString("DefaultConnection"));

            // Update in-memory details
            RequestItemDetails.details = RequestItemDetails.details
                .Where(d => !ExcludedItemCodes.Contains(d.ItemCode))
                .ToList();
        }

        // 2. Insert new rows into requisitiondetails
        foreach (var row in rows)
        {
            var detailData = new
            {
                HeaderId = RequestItemDetails.HeaderId,
                ItemCode = row.ItemCode ?? string.Empty,
                ItemDescription = row.ItemDescription ?? string.Empty,
                Quantity = row.Quantity,
                StockUom = row.StockUom ?? string.Empty,
                Remarks = row.Remarks ?? string.Empty
            };

            string detailSql = @"INSERT INTO requisitiondetails
                                (HeaderId, ItemCode, ItemDescription, Quantity, UOM, Consumption)
                                VALUES
                                (@HeaderId, @ItemCode, @ItemDescription, @Quantity, @StockUom, @Remarks);";

            await _data.SaveData(detailSql, detailData, _config.GetConnectionString("DefaultConnection"));

            // Add to in-memory details
            RequestItemDetails.details.Add(new RequisitionDetail
            {
                HeaderId = RequestItemDetails.HeaderId,
                ItemCode = row.ItemCode ?? string.Empty,
                ItemDescription = row.ItemDescription ?? string.Empty,
                Quantity = row.Quantity,
                UOM = row.StockUom ?? string.Empty,
                Notes = row.Remarks ?? string.Empty,
                Remarks = row.Remarks ?? string.Empty,
                Consumption = row.Consumption ?? string.Empty,
                SapStatus = string.Empty,
                DetailId = 0 // Will be set by database
            });
        }

        // 3. Reset state
        ExcludedItemCodes.Clear();
        rows.Clear();
        ResetInputs();
        isEditing = false;
        StateHasChanged();
    }

    private void HideEdit()
    {
        // Cancel changes: reset state without saving to database
        ExcludedItemCodes.Clear();
        rows.Clear();
        ResetInputs();
        isEditing = false;
        StateHasChanged();
    }

    private void RemoveRow(TableRow row) 
    {
        rows.Remove(row);
        StateHasChanged(); // Ensure UI updates
    }

    private void RemoveRequestedItem(string? itemCode)
    {
        if (string.IsNullOrEmpty(itemCode)) return;

        // Mark item as excluded for deletion
        if (!ExcludedItemCodes.Contains(itemCode))
        {
            ExcludedItemCodes.Add(itemCode);
        }

        // Remove from rows if it exists there
        var tempItem = rows.FirstOrDefault(x => x.ItemCode == itemCode);
        if (tempItem != null)
        {
            rows.Remove(tempItem);
        }

        StateHasChanged();
    }

