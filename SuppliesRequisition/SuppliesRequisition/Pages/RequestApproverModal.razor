    private void UpdateSelectedItem(ChangeEventArgs e)
    {
        selectedItemCode = e.Value?.ToString() ?? "";
        var foundItem = Items.FirstOrDefault(i => i.ItemCode == selectedItemCode); // Match ItemCode correctly

        if (foundItem != null)
        {
            selectedItem = new Items
            {
                ItemCode = foundItem.ItemCode,
                ItemName = foundItem.ItemName,
                Size = foundItem.Size,
                ChildColor = foundItem.ChildColor,
                InvntryUom = foundItem.InvntryUom
            };
            selectedItemDescription = foundItem.ItemName;
        }
        else
        {
            selectedItem = new Items();
            selectedItemDescription = "";
            selectedItemCode = ""; // Ensure reset if no item is found
        }

        StateHasChanged();
    }

